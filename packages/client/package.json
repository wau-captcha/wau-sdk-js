{
  "name": "@wau-captcha/client",
  "version": "1.1.0",
  "description": "Browser SDK for WAU Captcha: fetch and answer challenges, or drop in a ready-made widget.",
  "license": "MIT",
  "author": "WAU Captcha",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/wau-captcha.global.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/wau-captcha.global.js",
  "jsdelivr": "./dist/wau-captcha.global.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --global WauCaptcha --platform browser",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "captcha",
    "wau-captcha",
    "bot-protection",
    "browser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wau-captcha/wau-sdk-js.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/wau-captcha/wau-sdk-js#readme",
  "bugs": "https://github.com/wau-captcha/wau-sdk-js/issues"
}